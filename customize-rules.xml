<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Teedy Custom Metrics Rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">

  <description>
    Teedy custom PMD ruleset with 5 requested metrics: LoC, CC, WMC, CBO, LCOM.
  </description>

  <!-- LoC: Lines of Code (via NCSS threshold checks) -->
  <rule ref="category/java/design.xml/NcssCount">
    <properties>
      <property name="methodReportLevel" value="80"/>
      <property name="classReportLevel" value="600"/>
    </properties>
  </rule>

  <!-- CC: Cyclomatic Complexity (method level) -->
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="methodReportLevel" value="10"/>
      <property name="classReportLevel" value="99999"/>
    </properties>
  </rule>

  <!-- WMC: Weighted Methods per Class (class level from CyclomaticComplexity) -->
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="methodReportLevel" value="99999"/>
      <property name="classReportLevel" value="50"/>
    </properties>
  </rule>

  <!-- CBO: Coupling Between Objects -->
  <rule ref="category/java/design.xml/CouplingBetweenObjects">
    <properties>
      <property name="threshold" value="20"/>
    </properties>
  </rule>

  <!-- LCOM: Lack of Cohesion in Methods (approximated by GodClass cohesion checks) -->
  <rule ref="category/java/design.xml/GodClass"/>

</ruleset>
