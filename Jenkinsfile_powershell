pipeline {
    agent any
    environment {
        IMAGE_REPO = 'louis886/teedy-app'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        MINIKUBE_EXE = 'C:\\minikube\\minikube.exe'
    }
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }
        stage('Start Minikube') {
            steps {
                echo 'Ensuring Minikube is running...'
                powershell(script: 'docker network rm minikube', returnStatus: true)
                script {
                    def statusCheck = powershell(script: '& $env:MINIKUBE_EXE status --format "{{.Host}}"', returnStatus: true)
                    if (statusCheck != 0) {
                        echo 'Minikube status check failed; starting Minikube...'
                        def startStatus = powershell(script: '& $env:MINIKUBE_EXE start --driver=docker --memory=4096 --cpus=2', returnStatus: true)
                        if (startStatus != 0) {
                            echo 'Minikube start failed; deleting profile and retrying...'
                            powershell(script: '& $env:MINIKUBE_EXE delete', returnStatus: true)
                            startStatus = powershell(script: '& $env:MINIKUBE_EXE start --driver=docker --memory=4096 --cpus=2', returnStatus: true)
                            if (startStatus != 0) {
                                error('Minikube start failed after retry. Check Jenkins console for minikube output.')
                            }
                        }
                    } else {
                        def hostStatus = powershell(script: '& $env:MINIKUBE_EXE status --format "{{.Host}}"', returnStdout: true).trim()
                        if (hostStatus != 'Running') {
                            def startStatus = powershell(script: '& $env:MINIKUBE_EXE start --driver=docker --memory=4096 --cpus=2', returnStatus: true)
                            if (startStatus != 0) {
                                echo 'Minikube start failed; deleting profile and retrying...'
                                powershell(script: '& $env:MINIKUBE_EXE delete', returnStatus: true)
                                startStatus = powershell(script: '& $env:MINIKUBE_EXE start --driver=docker --memory=4096 --cpus=2', returnStatus: true)
                                if (startStatus != 0) {
                                    error('Minikube start failed after retry. Check Jenkins console for minikube output.')
                                }
                            }
                        }
                    }
                }
                powershell 'kubectl config use-context minikube'
                powershell 'kubectl wait --for=condition=Ready node/minikube --timeout=300s'
                echo 'Minikube started and ready.'
            }
        }
        stage('Set Image') {
            steps {
                echo 'Updating Teedy image in Kubernetes...'
                powershell '& $env:MINIKUBE_EXE image load $env:IMAGE_REPO:latest'
                powershell 'kubectl apply -f k8s-deployment.yaml'
                powershell 'kubectl set image deployment/teedy teedy=$env:IMAGE_REPO:$env:IMAGE_TAG'
                powershell 'kubectl rollout status deployment/teedy --timeout=300s'
            }
        }
        stage('Verify') {
            steps {
                echo 'Verifying deployment...'
                powershell 'kubectl get deployments'
                powershell 'kubectl get pods'
                powershell 'kubectl get services'
                powershell 'kubectl rollout status deployment/teedy --timeout=300s'
                script {
                    echo 'Getting Teedy service URL...'
                    def teedyUrl = powershell(script: '& $env:MINIKUBE_EXE service teedy --url', returnStdout: true).trim()
                    echo "Teedy application is available at: ${teedyUrl}"
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: '**/target/site/**/*.*', fingerprint: true
            archiveArtifacts artifacts: '**/target/**/*.jar', fingerprint: true
            archiveArtifacts artifacts: '**/target/**/*.war', fingerprint: true
            junit '**/target/surefire-reports/*.xml'
        }
    }
}
