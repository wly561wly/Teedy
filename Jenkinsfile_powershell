pipeline {
    agent any
    environment {
        IMAGE_REPO = 'louis886/teedy-app'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        MINIKUBE_EXE = 'C:\\minikube\\minikube.exe'
    }
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }
        stage('Deploy Teedy') {
            steps {
                echo 'Deploying Teedy to Kubernetes...'
                script {
                    def hasImage = powershell(script: 'docker images -q $env:IMAGE_REPO:latest', returnStdout: true).trim()
                    if (!hasImage) {
                        echo 'Local Docker image not found; pulling from registry...'
                        def pullStatus = powershell(script: 'docker pull $env:IMAGE_REPO:latest', returnStatus: true)
                        if (pullStatus != 0) {
                            error('Docker pull failed.')
                        }
                    } else {
                        echo "Local image found: $env:IMAGE_REPO:latest"
                    }
                }
                powershell 'kubectl config use-context minikube'
                echo "Loading image: $env:IMAGE_REPO:latest"
                powershell "& \"C:\\minikube\\minikube.exe\" image load louis886/teedy-app:latest"
                echo 'Applying Kubernetes configuration...'
                powershell 'kubectl apply -f k8s-deployment.yaml'
                powershell "kubectl set image deployment/teedy teedy=`$env:IMAGE_REPO:latest"
                echo 'Waiting for rollout to complete...'
                powershell 'kubectl rollout status deployment/teedy --timeout=300s'
            }
        }
        stage('Verify') {
            steps {
                echo 'Verifying deployment...'
                powershell 'kubectl get deployments'
                powershell 'kubectl get pods'
                powershell 'kubectl get services'
                script {
                    def teedyUrl = powershell(script: "& `$env:MINIKUBE_EXE service teedy --url", returnStdout: true).trim()
                    echo "==========================================="
                    echo "Teedy application is available at: ${teedyUrl}"
                    echo "==========================================="
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: '**/target/**/*.jar', fingerprint: true
            archiveArtifacts artifacts: '**/target/**/*.war', fingerprint: true
            junit '**/target/surefire-reports/*.xml'
        }
    }
}